{
  "name": "cascadedtl",
  "version": "0.1.0",
  "private": true,
  "description": "Batch DTL settlement simulator with deferred queues and dynamic priority.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test \"tests/node/*.test.js\"",
    "ci": "node scripts/build.mjs --warnings && node --test \"tests/node/*.test.js\"",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
