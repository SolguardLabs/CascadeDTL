{
  "editor.formatOnSave": true,
  "files.exclude": {
    "out": true,
    "build": true,
    "node_modules": true
  },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.includePath": ["${workspaceFolder}/src"]
}
